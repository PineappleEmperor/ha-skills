#!/usr/bin/env bash
# Enforce terse commits: subject <=72 chars, no narrative body, no AI-attribution trailers.
# Body lines allowed only as trailers (Key: value), Closes/Refs/Fixes #N, or any body when a
# BREAKING CHANGE footer is present. Enable once per clone: git config core.hooksPath .githooks
msg_file="$1"
subject="$(grep -v '^#' "$msg_file" | sed -n '1p')"

if [ "${#subject}" -gt 72 ]; then
  echo "commit-msg: subject is ${#subject} chars (>72). Keep it terse." >&2
  exit 1
fi
case "$subject" in "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;; esac

# The subject must be a Conventional Commit: a mapped type, lowercase after the colon,
# one imperative clause, no trailing period. lint_pr enforces this on the PR title; the
# release notes are built from these subjects, so an unmapped one lands in the wrong
# section of what users read.
if ! printf '%s' "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: [a-z]'; then
  echo "commit-msg: subject must be '<type>(<scope>)!: <lowercase imperative>'" >&2
  echo "    types: feat fix docs style refactor perf test build ci chore revert" >&2
  exit 1
fi
case "$subject" in *.) echo "commit-msg: subject must not end in a period." >&2; exit 1 ;; esac

# One commit, one change. "clear rows 86 to 88 and record the stale rename" passed every
# rule above and carried two; the release notes list a subject once, under one heading,
# so the second change is invisible to the reader. An `and` after the colon is the tell.
if printf '%s' "$subject" | sed 's/^[^:]*: //' | grep -Eqw 'and'; then
  echo "commit-msg: one change per commit — this subject joins two with 'and'. Split it." >&2
  echo "    $subject" >&2
  exit 1
fi

# Editorialising words. A subject can pass every shape rule above and still say nothing
# a reader can act on — "catch prose naming a job nobody ships" is well formed, and does
# not name the thing it changed. These words are where that creeps in.
if printf '%s' "$subject" | grep -Eqi '\b(actually|really|properly|simply|just|finally|nobody|somehow|stuff|magic|nice)\b'; then
  echo "commit-msg: editorialising subject — say what changed, not how you feel about it." >&2
  echo "    $subject" >&2
  exit 1
fi

# Reject harness-injected AI-attribution trailers (this skill bans them). A real human
# Co-Authored-By is still fine.
if grep -v '^#' "$msg_file" | grep -Eqi '^Co-authored-by:[[:space:]]*Claude|^Claude-Session:|Generated with .*(Claude|Anthropic)'; then
  echo "commit-msg: AI-attribution trailer not allowed (strip Co-Authored-By: Claude / Claude-Session)." >&2
  exit 1
fi

if grep -q 'BREAKING CHANGE' "$msg_file"; then
  exit 0
fi

bad=""
while IFS= read -r line; do
  [ -z "$line" ] && continue
  case "$line" in \#*) continue ;; esac
  printf '%s' "$line" | grep -Eq '^[A-Za-z][A-Za-z-]*: ' && continue
  printf '%s' "$line" | grep -Eq '^(Closes|Refs|Fixes|Resolves) #' && continue
  bad="$line"
  break
done < <(grep -v '^#' "$msg_file" | tail -n +2)

if [ -n "$bad" ]; then
  echo "commit-msg: narrative body line not allowed:" >&2
  echo "    $bad" >&2
  echo "Keep commits subject-only; put detail in the PR / release notes." >&2
  exit 1
fi
exit 0
