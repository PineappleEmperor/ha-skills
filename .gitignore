__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
node_modules/

# Shell/editor dotfiles that land in the workspace root. The project's own dotted
# paths are re-included, so a new one has to be named here to be tracked.
/.*
!/.github/
!/.githooks/
!/.claude-plugin/
!/.gitignore
# Everything under .claude/ is per-machine state, settings included: they name this
# machine's paths. The agent definitions below are the one exception.
!/.claude/
/.claude/*

# Repo-local agent definitions are conventions of this repo, so they travel with it.
!/.claude/agents/
